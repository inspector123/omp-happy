# Local source-mode defaults for:
#   pnpm --dir packages/happy-server standalone:dev
#
# This file is intentionally safe for one developer on one machine. The root
# `pnpm self-host:dev` path is preferred: `happy server` creates a random
# master secret and stores it with the isolated server data.

# Required by standalone mode.
DB_PROVIDER=pglite
HANDY_MASTER_SECRET=local-development-only-not-for-production

# Bind only to this machine by default. For LAN access, set HOST=0.0.0.0 and
# PUBLIC_URL to the reachable LAN origin.
HOST=127.0.0.1
PORT=3005
PUBLIC_URL=http://127.0.0.1:3005
NODE_ENV=development
DATA_DIR=./data/dev
PGLITE_DIR=./data/dev/pglite

# Optional diagnostics. Leave dangerous plaintext client logging unset unless
# you are actively debugging on a trusted machine.
METRICS_ENABLED=false
METRICS_PORT=9090
# DANGEROUSLY_LOG_TO_SERVER_FOR_AI_AUTO_DEBUGGING=1

# Optional scale-out services. Standalone mode does not need Postgres, Redis,
# or S3. See docs/deployment.md before enabling these.
# DB_PROVIDER=postgres
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# REDIS_URL=redis://HOST:6379
# S3_HOST=storage.example.com
# S3_PORT=443
# S3_USE_SSL=true
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=happy
# S3_PUBLIC_URL=https://storage.example.com/happy

# Optional integrations.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URL=
# ELEVENLABS_API_KEY=
# REVENUECAT_API_KEY=
